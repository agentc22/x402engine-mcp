  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentc22/x402engine-mcp.git"
  },
  "homepage": "https://x402engine.app",
  "bugs": {
    "url": "https://github.com/agentc22/x402engine-mcp/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
